# Copy to apps/web/.env.local for local development (never commit secrets).

# Public Supabase values (safe for client with RLS enabled)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Server-only — Edge Functions / seed / CI. NEVER put in apps/web or VITE_*.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# SUPABASE_ACCESS_TOKEN=your_personal_access_token_for_cli_deploy
